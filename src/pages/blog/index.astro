---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { getTranslations } from '../../i18n/utils';

const locale = 'en';
const t = getTranslations(locale);
---

<PageLayout locale={locale} title={t.nav.blog}>
  <section class="section page-header">
    <div class="container">
      <span class="section-label">{t.nav.blog}</span>
      <h1>Insights</h1>
      <p class="section-subtitle">
        Technical perspectives on cloud, AI engineering, and IaC industrialization.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="empty-state card">
        <h3>Articles coming soon</h3>
        <p>
          We are preparing a series of technical articles on Azure architecture, AI agentic workflows,
          and IaC industrialization. Stay tuned.
        </p>
        <a href="https://www.linkedin.com/company/dakina" target="_blank" rel="noopener" class="btn btn-secondary" style="margin-top: 24px;">
          → Follow us on LinkedIn
        </a>
      </div>
    </div>
  </section>

  <CTASection locale={locale} />
</PageLayout>

<style>
  .page-header { padding-top: var(--space-16); padding-bottom: var(--space-8); }
  .empty-state {
    text-align: center;
    padding: var(--space-16);
    max-width: 720px;
    margin: 0 auto;
  }
  .empty-state h3 { margin-bottom: var(--space-4); }
  .empty-state p { color: var(--gray-200); }
</style>
