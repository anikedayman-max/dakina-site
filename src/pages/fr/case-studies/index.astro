---
import PageLayout from '../../../layouts/PageLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import { getTranslations } from '../../../i18n/utils';

const locale = 'fr';
const t = getTranslations(locale);
---

<PageLayout locale={locale} title={t.nav.caseStudies}>
  <section class="section page-header">
    <div class="container">
      <span class="section-label">{t.nav.caseStudies}</span>
      <h1>Études de cas</h1>
      <p class="section-subtitle">
        Sélection de missions en cloud, IA et industrialisation IaC. D'autres cas arrivent prochainement.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="empty-state card">
        <h3>Études de cas en préparation</h3>
        <p>
          Nous anonymisons et préparons actuellement nos retours de mission récents.
          Ils apparaîtront ici progressivement. Entre-temps, contactez-nous directement
          pour des références pertinentes sur demande.
        </p>
        <a href="/fr/contact" class="btn btn-primary" style="margin-top: 24px;">
          {t.cta.button} →
        </a>
      </div>
    </div>
  </section>

  <CTASection locale={locale} />
</PageLayout>

<style>
  .page-header { padding-top: var(--space-16); padding-bottom: var(--space-8); }
  .empty-state {
    text-align: center;
    padding: var(--space-16);
    max-width: 720px;
    margin: 0 auto;
  }
  .empty-state h3 { margin-bottom: var(--space-4); }
  .empty-state p { color: var(--gray-200); }
</style>
