---
import PageLayout from '../../../layouts/PageLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import { getTranslations } from '../../../i18n/utils';

const locale = 'fr';
const t = getTranslations(locale);
---

<PageLayout locale={locale} title={t.nav.industries} description={t.industries.subtitle}>
  <section class="section page-header">
    <div class="container">
      <span class="section-label">{t.industries.label}</span>
      <h1>{t.industries.title}</h1>
      <p class="section-subtitle">{t.industries.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        {t.industries.items.map((industry) => (
          <a href={`/fr/industries/${industry.slug}`} class="card industry-card">
            <span class="card-icon">{industry.icon}</span>
            <h3 class="card-title">{industry.title}</h3>
            <p class="card-description">{industry.description}</p>
            <span style="color: var(--cyan); font-size: 0.9rem; font-weight: 500; margin-top: 16px;">{t.common.learnMore} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection locale={locale} />
</PageLayout>

<style>
  .page-header {
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }
  .industry-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
</style>
