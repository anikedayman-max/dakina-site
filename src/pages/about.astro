---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/CTASection.astro';
import { getTranslations } from '../i18n/utils';

const locale = 'en';
const t = getTranslations(locale);
---

<PageLayout locale={locale} title={t.nav.about} description={t.about.subtitle}>
  <section class="section page-header">
    <div class="container">
      <span class="section-label">{t.about.eyebrow}</span>
      <h1>{t.about.title}</h1>
      <p class="section-subtitle">{t.about.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-content">
        {t.about.sections.map((section) => (
          <article class="card about-block">
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.bullets && (
              <ul class="content-list">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="section-label">Principles</span>
      <div class="grid grid-2 principle-grid">
        {t.about.principles.map((principle) => (
          <div class="card principle-card">
            <h3 class="card-title">{principle.title}</h3>
            <p class="card-description">{principle.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card about-cta">
        <div>
          <h3>{t.cta.title}</h3>
          <p>{t.cta.subtitle}</p>
        </div>
        <a href="/contact" class="btn btn-primary">{t.cta.button} →</a>
      </div>
    </div>
  </section>

  <CTASection locale={locale} />
</PageLayout>

<style>
  .page-header { padding-top: var(--space-16); padding-bottom: var(--space-8); }
  .about-content {
    display: grid;
    gap: var(--space-6);
  }
  .about-block h2 { margin-bottom: var(--space-4); }
  .about-block p { color: var(--gray-200); margin-bottom: var(--space-4); line-height: 1.8; max-width: 760px; }
  .content-list { margin-top: var(--space-4); padding-left: 0; }
  .content-list li { color: var(--gray-200); margin-bottom: var(--space-3); padding-left: 24px; position: relative; line-height: 1.7; }
  .content-list li::before { content: '→'; position: absolute; left: 0; color: var(--cyan); }
  .principle-card { min-height: 100%; }
  .about-cta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .about-cta p {
    color: var(--gray-200);
    max-width: 720px;
    margin: var(--space-3) 0 0;
  }
</style>
