---
import PageLayout from '../../layouts/PageLayout.astro';
import CTASection from '../../components/CTASection.astro';
import { getTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const t = getTranslations('en');
  return t.services.items.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const locale = 'en';
const t = getTranslations(locale);
---

<PageLayout locale={locale} title={service.title} description={service.shortDescription}>
  <section class="section page-header">
    <div class="container">
      <a href="/services" class="back-link">← {t.common.back} {t.nav.services.toLowerCase()}</a>
      <span class="service-icon">{service.icon}</span>
      <h1>{service.title}</h1>
      <p class="lead">{service.shortDescription}</p>
      <div class="card-tags" style="justify-content: flex-start; margin-top: 24px;">
        {service.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-grid">
        <div class="content-main">
          <h2>How we approach it</h2>
          <p>
            This page is a placeholder — detailed content for the <strong>{service.title}</strong> service
            will be filled in shortly. Each service page will include the following sections:
          </p>
          <ul class="content-list">
            <li><strong>The problem we solve</strong> — the concrete pain points this service addresses.</li>
            <li><strong>Our delivery approach</strong> — methodology, tooling, deliverables.</li>
            <li><strong>What you get</strong> — tangible outputs, documentation, knowledge transfer.</li>
            <li><strong>Typical engagement formats</strong> — sprint, advisory, long-term partnership.</li>
            <li><strong>Related case studies</strong> — when available.</li>
          </ul>
        </div>

        <aside class="content-sidebar">
          <div class="card">
            <h4 class="card-title">Engagement formats</h4>
            <ul class="sidebar-list">
              <li>Sprint advisory (2–4 weeks)</li>
              <li>Fixed-scope project</li>
              <li>Long-term partnership</li>
              <li>Strategic review</li>
            </ul>
          </div>

          <div class="card" style="margin-top: 20px;">
            <h4 class="card-title">Get in touch</h4>
            <p class="card-description">
              Discuss your needs in a first call, no commitment.
            </p>
            <a href="/contact" class="btn btn-primary" style="margin-top: 12px; width: 100%; justify-content: center;">
              {t.cta.button} →
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CTASection locale={locale} />
</PageLayout>

<style>
  .page-header {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
  }

  .back-link {
    display: inline-block;
    color: var(--gray-300);
    font-size: 0.9rem;
    margin-bottom: var(--space-6);
  }

  .back-link:hover {
    color: var(--cyan);
  }

  .service-icon {
    display: inline-block;
    font-size: 3rem;
    margin-bottom: var(--space-4);
  }

  .page-header h1 {
    margin-bottom: var(--space-4);
  }

  .lead {
    font-size: 1.25rem;
    color: var(--gray-200);
    max-width: 720px;
    line-height: 1.6;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-12);
  }

  .content-main h2 {
    margin-bottom: var(--space-6);
  }

  .content-main p {
    color: var(--gray-200);
    margin-bottom: var(--space-6);
    line-height: 1.8;
  }

  .content-list {
    margin-top: var(--space-4);
    padding-left: 0;
  }

  .content-list li {
    color: var(--gray-200);
    margin-bottom: var(--space-3);
    padding-left: 24px;
    position: relative;
    line-height: 1.7;
  }

  .content-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--cyan);
  }

  .sidebar-list li {
    padding: 8px 0;
    color: var(--gray-200);
    font-size: 0.95rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sidebar-list li:last-child {
    border-bottom: none;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
