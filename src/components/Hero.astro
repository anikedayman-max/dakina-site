---
import { getTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const base = locale === 'en' ? '' : '/fr';
---

<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-glow-b"></div>
  <div class="hero-glow-c"></div>
  <img src="/logo.svg" alt="" class="hero-logo-bg" aria-hidden="true" />

  <div class="container hero-inner">
    <h1 class="hero-title">{t.hero.title}</h1>
    <p class="hero-subtitle">{t.hero.subtitle}</p>

    <div class="hero-ctas">
      <a href={`${base}/contact`} class="btn btn-primary">{t.hero.primaryCta} →</a>
      <a href={`${base}/services`} class="btn btn-secondary">{t.hero.secondaryCta}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 94vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-20) 0 var(--space-16);
    overflow: hidden;
  }

  /* ---- Glow orbs ---- */
  .hero-glow {
    position: absolute;
    top: -280px;
    left: 50%;
    transform: translateX(-50%);
    width: 1000px;
    height: 1000px;
    background:
      radial-gradient(circle at center, rgba(0, 212, 255, 0.28) 0%, rgba(0, 212, 255, 0.1) 22%, transparent 54%),
      radial-gradient(circle at 35% 40%, rgba(26, 107, 255, 0.22), transparent 38%);
    filter: blur(6px);
    pointer-events: none;
    z-index: 0;
    animation: glowPulse 10s ease-in-out infinite alternate;
  }

  .hero-glow-b {
    position: absolute;
    bottom: -240px;
    right: -80px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(77, 143, 255, 0.18) 0%, transparent 55%);
    filter: blur(30px);
    pointer-events: none;
    z-index: 0;
    animation: glowFloat 14s ease-in-out 2s infinite alternate;
  }

  .hero-glow-c {
    position: absolute;
    top: 30%;
    left: -120px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 200, 160, 0.12) 0%, transparent 55%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
    animation: glowFloat 18s ease-in-out 4s infinite alternate-reverse;
  }

  /* ---- Logo watermark ---- */
  .hero-logo-bg {
    position: absolute;
    right: 6%;
    top: 50%;
    transform: translateY(-50%);
    width: 440px;
    height: 440px;
    object-fit: contain;
    opacity: 0.12;
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: 0;
    animation: logoFloat 22s ease-in-out infinite alternate;
  }

  /* ---- Content ---- */
  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    max-width: 900px;
    margin-bottom: var(--space-6);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    background: linear-gradient(180deg, var(--white) 0%, var(--gray-200) 60%, var(--cyan) 140%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: heroFadeUp 0.9s var(--ease) 0.25s both;
  }

  .hero-subtitle {
    max-width: 660px;
    font-size: 1.15rem;
    color: var(--gray-200);
    line-height: 1.8;
    margin-bottom: var(--space-10);
    animation: heroFadeUp 0.9s var(--ease) 0.4s both;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    animation: heroFadeUp 0.9s var(--ease) 0.55s both;
  }

  /* ---- Keyframes ---- */
  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes glowPulse {
    from { transform: translateX(-50%) scale(0.96); opacity: 0.85; }
    to { transform: translateX(-50%) scale(1.08); opacity: 1; }
  }

  @keyframes glowFloat {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-35px, 25px, 0) scale(1.1); }
  }

  @keyframes logoFloat {
    from { transform: translateY(-50%) rotate(0deg) scale(1); }
    to { transform: translateY(-50%) rotate(4deg) scale(1.04); }
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding: var(--space-16) 0 var(--space-12);
    }
    .hero-logo-bg {
      width: 280px;
      height: 280px;
      right: -40px;
      opacity: 0.08;
    }
  }

  @media (max-width: 600px) {
    .hero-eyebrow {
      font-size: 0.75rem;
    }
    .hero-logo-bg {
      width: 200px;
      height: 200px;
      opacity: 0.06;
    }
  }
</style>
