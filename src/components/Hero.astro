---
import { getTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const base = locale === 'en' ? '' : '/fr';
---

<section class="hero">
  <div class="hero-glow"></div>
  <div class="container hero-inner">
    <div class="hero-pills">
      {t.hero.pills.map((pill) => (
        <span class="hero-pill">{pill}</span>
      ))}
    </div>

    <span class="section-label">{t.hero.label}</span>
    <h1 class="hero-title">{t.hero.title}</h1>
    <p class="hero-subtitle">{t.hero.subtitle}</p>

    <div class="hero-ctas">
      <a href={`${base}/contact`} class="btn btn-primary">{t.hero.primaryCta} →</a>
      <a href={`${base}/services`} class="btn btn-secondary">{t.hero.secondaryCta}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-24) 0 var(--space-20);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, var(--cyan-glow) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-pills {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .hero-pill {
    font-size: 0.8rem;
    padding: 6px 14px;
    border-radius: 20px;
    background: rgba(0, 212, 255, 0.06);
    color: var(--cyan);
    border: 1px solid rgba(0, 212, 255, 0.15);
    font-weight: 500;
  }

  .hero-title {
    max-width: 920px;
    margin: 0 auto var(--space-6);
    background: linear-gradient(180deg, var(--white) 0%, var(--gray-200) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    max-width: 720px;
    margin: 0 auto var(--space-10);
    font-size: 1.15rem;
    color: var(--gray-200);
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
