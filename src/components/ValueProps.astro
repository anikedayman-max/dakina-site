---
import { getTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="section value-props reveal">
  <div class="container">
    <div class="text-center">
      <span class="section-label">{t.valueProps.title}</span>
      <h2 class="section-title">{t.valueProps.subtitle}</h2>
    </div>

    <div class="grid grid-2 value-grid">
      {t.valueProps.items.map((item, index) => (
        <div class="value-card card">
          <div class="value-number">0{index + 1}</div>
          <h3 class="card-title">{item.title}</h3>
          <p class="card-description">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .value-grid {
    margin-top: var(--space-12);
  }

  .value-card {
    position: relative;
    padding-left: 80px;
  }

  .value-number {
    position: absolute;
    top: var(--space-8);
    left: var(--space-6);
    font-family: var(--font-head);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cyan);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 212, 255, 0.08);
    border-radius: 12px;
  }

  @media (max-width: 600px) {
    .value-card {
      padding-left: var(--space-6);
      padding-top: 80px;
    }
    .value-number {
      top: var(--space-6);
    }
  }
</style>
